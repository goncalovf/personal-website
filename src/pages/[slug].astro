---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import { blogPosting } from '../components/blogPosting';
import { getPosts, isoDate, type Post } from '../site';

export async function getStaticPaths() {
	// The multi-page guide has its own route.
	return ( await getPosts() )
		.filter( ( post ) => !post.data.multiPage )
		.map( ( post ) => ( { params: { slug: post.id }, props: { post } } ) );
}

const { post } = Astro.props as { post: Post };
const { Content } = await render( post );
const url = new URL( Astro.url.pathname, Astro.site );
---

<Base
	title={ post.data.title }
	description={ post.data.description }
	jsonLd={ blogPosting( post, url ) }
	image={ post.data.cover }
	article={ { published: isoDate( post.data.date ), modified: isoDate( post.data.updated ), tags: post.data.tags } }
>
	<article class="post">
		<header>
			<h1>{ post.data.title }</h1>
			<PostMeta post={ post } />
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</Base>
