---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
	title?: string;
	description?: string;
	/** JSON-LD object(s) for this page. */
	jsonLd?: object;
	article?: { published: string; modified: string; tags: string[] };
	image?: string;
	wide?: boolean;
}

const { title, description = SITE.tagline, jsonLd, article, image, wide = false } = Astro.props;
const pageTitle = title ? `${ title } – ${ SITE.name }` : SITE.name;
const canonical = new URL( Astro.url.pathname, Astro.site );
const ogImage = new URL( image ?? SITE.ogImage, Astro.site );
// GA4 measurement ID (G-…). The WordPress site used a Universal Analytics ID, which Google no longer processes.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{ pageTitle }</title>
		<meta name="description" content={ description } />
		<link rel="canonical" href={ canonical } />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:site_name" content={ SITE.name } />
		<meta property="og:title" content={ title ?? SITE.name } />
		<meta property="og:description" content={ description } />
		<meta property="og:url" content={ canonical } />
		<meta property="og:image" content={ ogImage } />
		<meta property="og:type" content={ article ? 'article' : 'website' } />
		{ article && (
			<>
				<meta property="article:published_time" content={ article.published } />
				<meta property="article:modified_time" content={ article.modified } />
				{ article.tags.map( ( t ) => <meta property="article:tag" content={ t } /> ) }
			</>
		) }
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:creator" content="@goncalovf" />

		{ jsonLd && <script type="application/ld+json" set:html={ JSON.stringify( { '@context': 'https://schema.org', ...jsonLd } ) } /> }

		{ import.meta.env.PROD && gaId && (
			<>
				<script async src={ `https://www.googletagmanager.com/gtag/js?id=${ gaId }` }></script>
				<script is:inline define:vars={ { gaId } }>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push( arguments ); }
					gtag( 'js', new Date() );
					gtag( 'config', gaId );
				</script>
			</>
		) }
		<slot name="head" />
	</head>
	<body class:list={ { wide } }>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="site-title" href="/" rel="home">{ SITE.name }</a>
		</header>
		<main id="main" class="site-main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
